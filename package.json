{
  "name": "extra-comment-tools",
  "displayName": "引用コメントツール",
  "version": "4.2.3",
  "description": "ニコニコ動画の引用コメント関連のツール",
  "author": "Midra <me@midra.me> (https://github.com/Midra429)",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "pre": "wxt prepare",
    "dev:chrome": "wxt -b chrome",
    "dev:firefox": "wxt -b firefox",
    "build": "bun run --sequential \"build:*\"",
    "build:chrome": "wxt build -b chrome",
    "build:firefox": "wxt build -b firefox",
    "zip": "bun run --sequential \"zip:*\"",
    "zip:chrome": "wxt zip -b chrome",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "tsc --noEmit --skipLibCheck",
    "check": "biome check --write"
  },
  "dependencies": {
    "@heroui/react": "^2.8.10",
    "@icons-pack/react-simple-icons": "^13.15.1",
    "@internationalized/date": "^3.12.4",
    "@midra/nco-utils": "^1.4.3",
    "@webext-core/messaging": "^3.0.3",
    "@wxt-dev/is-background": "^1.0.1",
    "colord": "^2.10.0",
    "deepmerge": "^4.3.1",
    "fast-deep-equal": "^3.1.3",
    "filesize": "^11.0.25",
    "framer-motion": "^12.43.0",
    "lucide-react": "^1.50.0",
    "nanoid": "^6.0.1",
    "nanoid-dictionary": "^5.0.0",
    "react": "^19.3.0",
    "react-detectable-overflow": "^0.8.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@rolldown/plugin-babel": "^0.2.4",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/nanoid-dictionary": "^4.2.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/webextension-polyfill": "^0.12.6",
    "@wxt-dev/auto-icons": "^1.1.2",
    "@wxt-dev/module-react": "^1.2.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "utility-types": "^3.11.0",
    "wxt": "^0.21.4"
  }
}
